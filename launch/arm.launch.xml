<?xml version="1.0"?>
<launch>

  <!-- ===================== -->
  <!--      Arguments        -->
  <!-- ===================== -->
  <arg name="namespace" default="hardware"/>
  <arg name="use_sim_time" default="false"/>

  <!-- ===================== -->
  <!--        Arm Node       -->
  <!-- ===================== -->
  <group>
    <push_ros_namespace namespace="$(var namespace)"/>

    <node
      pkg="arms"
      exec="arm_node"
      name="arm_node"
      output="screen">

      <param name="use_sim_time" value="$(var use_sim_time)"/>
      <rosparam file="$(find-pkg-share arms)/config/right_arm_params.yaml"/>

    </node>
  </group>

</launch>

