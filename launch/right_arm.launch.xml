<?xml version="1.0"?>
<launch>

  <group>
    <push_ros_namespace namespace="arms"/>

    <node
      pkg="arms"
      exec="arm_node"
      name="arm_node"
      output="screen">

      <param name="use_sim_time" value="false"/>
      <param from="$(find-pkg-share arms)/config/right_arm_params.yaml"/>

    </node>
  </group>

</launch>
